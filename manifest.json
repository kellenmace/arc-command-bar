{
  "manifest_version": 3,
  "name": "Arc Command Bar",
  "version": "0.1.0",
  "description": "A Chrome command bar for switching tabs, opening URLs, searching history, and searching sites.",
  "homepage_url": "https://github.com/kellenmace/arc-command-bar",
  "minimum_chrome_version": "127",
  "permissions": ["activeTab", "favicon", "history", "scripting", "search", "tabs", "topSites"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Arc Command Bar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["command-bar.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
